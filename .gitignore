# Что не хранить в git.
#
# Отсекаем всё, что генерируется, весит много или содержит личные данные:
__pycache__/
*.pyc
*.pyo

# Сборка: пересобирается скриптом, весит сотни мегабайт.
build/
dist/
installer/*_Setup.exe

# Библиотеки: 120 МБ, лежат в поставке и пересборке не нужны.
libmpv-2.dll
vulkan-1.dll

# Личные данные: вход в Telegram, история, настройки, журналы.
*.session
*.session-journal
*.session-wal
*.session-shm
history.json
settings.json
tgplayer.log
tgplayer.log.*

# Кеш роликов и временные файлы моих проверок.
stream_cache/
_*.txt
_*.png
_*.bmp

# Бэкапы исходников: копии того, что уже есть в git, дублировать смысла нет.
_backups/

# Распакованные сборки для сравнения версий: это чужой код, весит много,
# и его всегда можно собрать заново из установщика.
_inst_probe/
_extracted_1810/
_extracted_1810.bin
version_info_gen.txt
